            Summary__c = '                             The resources below provide information and best practices on optimizing your local listings, Google Business Profile (GBP) listing as well as other external listings and reviews to ensure customers can find you when sear<!-- truncated -->',
            Body__c = '\n        <div class="container-fluid">\n            <!--<div class="row justify-content-center">\n                <div class="col-lg-5">\n                    <div class="section_tittle text-center">\n                        <p>recent work</p>\n                        <h2>Creative work for client</h2>\n                    </div>\n                </div>\n            </div>-->\n            <div class="row">\n                <div class="col-lg-12">\n                    \n                    <div class="single_work">\n                        <div class="row align-items-center">\n                            <div class="container">\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t<div class="col-lg-8 col-sm-8 padding_hub_1">\n\t\t\t\t\t\t\t\t\t<div class="about_text_left">\n\t\t\t\t\t\t\t\t\t  <h3>Search Engine Optimization (SEO)</h3>\n                             <p>The resources below provide information and best practices on optimizing your local listings, Google Business Profile (GBP) listing as well as other external listings and reviews to ensure customers can find you when searching online.</p>\n\t\t\t\t\t\t\t\t\t\t<ul id="content">\n<li><a href="?Action=GET&amp;ID=brandstandards/localmarketing/files/What_Is_SEO_April_2022.pdf">What is SEO?</a> (9 Page PDF)</li>\n                                            <li><a href="?Action=GET&amp;ID=brandstandards/localmarketing/files/SEO_and_AI_Search_Overview_-_June_2026.pdf">SEO and AI Search Overview - great information to know regarding AI-related search</a> (1 Page PDF)</li>\n<li><a href="?Action=GET&amp;ID=brandstandards/localmarketing/files/Your_Guide_to_SEO_and_AEO.pdf">Your Guide to SEO and GEO</a> (5 Page PDF)</li>                                           \n<li><a href="?Action=GET&amp;ID=brandstandards/localmarketing/files/SEO_Top_Activities_March2024.pdf">Top 5 Local SEO Action Items</a> (1 Page PDF)</li>\n<li><a href="?Action=GET&amp;ID=brandstandards/localmarketing/files/Online_Reviews_and_Impact_on_Visibility_March_2024_v2.pdf">Online Reviews &amp; Impact on Visibility</a> (3 Page PDF)</li>\n                                           \n                                      </ul>\n<h3>Local Search</h3>\n\t\t\t\t\t\t\t\t\t\t<ul id="content">\n<li><a href="?Action=GET&amp;ID=brandstandards/localmarketing/files/Google_Business_Profile_-_Local_Search_-_August_2023.pdf">Google Business Profile &amp; Local Search</a> (12 Page PDF)</li>\n<li><a href="https://choiceutv.com/novusiii/content/item/8144" target="_blank">Backlinking: what is it and its importance?</a> (ChoiceU link)</li>\n<li><a href="?Action=GET&amp;ID=brandstandards/localmarketing/files/property-backlinking-tracker.xlsx">Backlinking Tracker: use this to get started</a> (1 Sheet XLSX)</li>\n\t\t\t\t\t\t\t\t\t  </ul>\n<h3>Google Business Profile</h3>\n\t\t\t\t\t\t\t\t\t\t<ul id="content">\n\t\t\t\t\t\t\t\t\t\t\t\n<li><a href="https://choiceutv.com/novusiii/content/item/8015" target="_blank">How to Identify and Flag Google Photos</a> (ChoiceU link)</li>\n<li><a href="?Action=GET&amp;ID=brandstandards/localmarketing/files/digital-marketing-google-my-business-101.pdf">Google My Business 101</a> (11 Page PDF)</li>\n<li><a href="?Action=GET&amp;ID=brandstandards/localmarketing/files/Accessing_Your_Google_Business_Profile_-_August_2023.pdf">Accessing Your Hotel\'s Google My Business Listing</a> (3 Pages PDF)</li>\n<li><a href="?Action=GET&amp;ID=brandstandards/localmarketing/files/Google_Business_Profile_Sustainability_Attributes_March2024.pdf">Updating Your Hotel\'s Google My Business Listing - Sustainability Attributes</a> (2 Page PDF)</li>\n\t\t\t\t\t\t\t\t\t\t</ul>\n<h3>Check out these videos available on ChoiceU to hear more: </h3>\n<ul id="content">\n\t\n<li><a href="https://choiceutv.com/novusiii/content/item/8015" target="_blank">How to Identify &amp; Flag Google Photos</a> (ChoiceU link)</li>\n<li><a href="https://choiceutv.com/novusiii/content/item/8239" target="_blank">Influencing Your Google Star Rating</a> (ChoiceU link) </li>\n<li><a href="https://choiceutv.com/novusiii/content/item/8144" target="_blank">Backlinking: What it is and its Importance</a> (ChoiceU link) </li>\n\t</ul>\n\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-lg-4 col-sm-4">\n\t\t\t\t\t\t\t\t\t<div class="about_text_right">\n\t\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\t</div>\n   \t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n                            </div>\n                            \n                        </div>\n                    </div>\n\t\t\t\t\t\n                    \n                    \n                    \n                   \n \n                </div>\n            </div>\n        </div>\n    ',
            Status__c = 'Published'
        ));

        translations.add(new Translations__c(
