            Body__c = '\n        <div class="container-fluid">\n            <!--<div class="row justify-content-center">\n                <div class="col-lg-5">\n                    <div class="section_tittle text-center">\n                        <p>recent work</p>\n                        <h2>Creative work for client</h2>\n                    </div>\n                </div>\n            </div>-->\n            <div class="row">\n                <div class="col-lg-12">\n                    \n                    <div class="single_work">\n                        <div class="row align-items-center">\n                            <div class="container">\n\t\t\t\t\t\t\t\t<p id="regular-top">Showcasing your hotel through strong, up-to-date photography and professional, on-brand collateral is an important part of your local marketing efforts. Be sure to take advantage of the tools and Qualified Vendors that Choice Hotels makes available to you: </p>\n<ul id="content">\n<li><a href="collateral.asp">Create On-Brand Collateral for FREE with SmartMarketing (legacy Choice Brands) and DataSource (legacy Radisson Brands)</a></li>\n<li><a href="https://apps.choicecentral.com/ccweb/content/resources/ecomm/chcom/EbrochPhoto.html" target="_blank">Learn More About Photography</a></li>\n\t</ul>\n                             \n                          </div>\n                            \n                        </div>\n                    </div>\n                    \n                    \n                    \n                   \n \n                </div>\n            </div>\n        </div>\n    ',
            Status__c = 'Published'
        ));

        translations.add(new Translations__c(
            Content__c = categoryMap.get(LIBRARY_ID_PREFIX + '-co-op-marketing').Id,
            Name = 'English',
            Version__c = 1,
            Title__c = 'Co-op Marketing Program',
            Summary__c = '                             Franchisee  leaders, in collaboration with Choice, have developed a powerful program to  promote Co-op member hotels in the U.S. and help drive revenue and bookings at  regional, state and local levels. Eligible Brands ca<!-- truncated -->',
            Body__c = '\n        <div class="container-fluid">\n            <!--<div class="row justify-content-center">\n                <div class="col-lg-5">\n                    <div class="section_tittle text-center">\n                        <p>recent work</p>\n                        <h2>Creative work for client</h2>\n                    </div>\n                </div>\n            </div>-->\n            <div class="row">\n                <div class="col-lg-12">\n                    \n                    <div class="single_work">\n                        <div class="row align-items-center">\n                            <div class="container">\n\t\t\t\t\t\t\t\t<h3>What is the Co-op Marketing Program?</h3>\n                             <p>Franchisee  leaders, in collaboration with Choice, have developed a powerful program to  promote Co-op member hotels in the U.S. and help drive revenue and bookings at  regional, state and local levels. Eligible Brands can benefit from national  marketing initiatives, and this enhanced strategy is amplified significantly by  joining efforts with other participating Choice properties for a more  regionalized and targeted approach.</p>\n                             <p>                               Learn more and join the  Co-op Marketing Programs today:</p>\n                             <ul id="content">\n                               <li><a href="https://snapt.io/UZNFG" target="_blank">CHOC Co-op Marketing  Program</a></li>\n                               <ul id="content">\n                                 <li>Eligible Brands include:  Ascend®, Comfort®, Sleep Inn®, Quality Inn®, Clarion®, Clarion Pointe®</li>\n                                 <li><a href="?Action=GET&amp;ID=brandstandards/LocalMarketing/files/CHOC_Co-op_Marketing_Program_2026.pdf">CHOC Co-op Marketing  Program One Pager </a>(1 Page PDF)</li>\n                                 <li><a href="https://form.jotform.com/220766259491060" target="_blank">Join here</a></li>\n                               </ul>\n                             \n                               <li>Economy Co-op Marketing  Program</li>\n                               <ul id="content">\n                                 <li>Eligible Brands include:  Econo Lodge®, Rodeway Inn® and Park Inn by Radisson</li>\n                                 <li><a href="?Action=GET&amp;ID=brandstandards/LocalMarketing/files/Economy_Co-op_Marketing_Program_2026.pdf">Economy Co-op Marketing  Program One Pager</a> (1 Page PDF)</li>\n                                 <li><a href="https://choicehotels.service-now.com/hp?id=hp24_form&amp;table=sn_customerservice_case&amp;sys_id=73660a3edb4c01d09eef2ebb13961945" target="_blank">Join here</a></li>\n                               </ul>\n                                 <li><a href="https://choicehotels.service-now.com/hp?id=hp24_form&amp;table=sn_customerservice_case&amp;sys_id=eae75e571b7baa10923a1132b24bcb94" target="_blank">Extended Stay Co-op Marketing Program</a> (NEW for 2026!)</li>\n<ul id="content">\n  <li>Eligible Brands include: Everhome Suites®, MainStay Suites® and Suburban Studios®</li>\n    <li><a href="?Action=GET&amp;ID=brandstandards/LocalMarketing/files/Extended_Stay_Collateral_Refresh.pdf">Extended Stay Co-op Marketing Program One Pager</a> (1 Page PDF)</li>\n                                 </ul>\n\n                               <li>Co-op Marketing Program  –&nbsp;<a href="?Action=GET&amp;ID=brandstandards/LocalMarketing/files/How_to_Join_the_Co-op_Marketing_Program_-_September_2025.pdf">Costs and How to Join</a>&nbsp;(2 Pages PDF) </li>\n                             </ul>\n                             \n                             <p><br>\n                               <strong>How can I see how the  Co-op Marketing Program is benefiting my hotel?</strong></p>\n                             <p>Co-op Participating hotels can view a report each month. Access your Co-op Online Banner Ad Report on ChoiceCONNECT › Properties › Reports › Co-op Marketing Program\n</p>\n                             \n<div style="border: red 2px solid; padding: 20px 20px 10px">\n\t\t        <p><strong>Through 2026 - Join the Co-op  Marketing Program Today!</strong></p><p>Join the Co-op Marketing Program today and we will provide a money back guarantee by refunding your annual dues if you do not generate room revenue equal to, or greater than, your annual dues.</p>\n\t\t        <p><a href="co-op-terms-conditions.asp">Terms &amp; Conditions Apply</a></p>\n</div>\n\t\t\t\t\t\t\t\t<p id="legal">&nbsp;</p>\n                                \n\n                          </div>\n                            \n                        </div>\n                    </div>\n                    \n                    \n                    \n                   \n \n                </div>\n            </div>\n        </div>\n    ',
            Status__c = 'Published'
        ));

        translations.add(new Translations__c(
            Content__c = categoryMap.get(LIBRARY_ID_PREFIX + '-new-hotels').Id,
            Name = 'English',
            Version__c = 1,
            Title__c = 'New Hotels',
            Summary__c = '                             Choice wants to help you along your opening journey.  For new hotels, Choice has developed these checklists to get you started with  key local marketing activities to fit your hotel’s opening. Simply choose the  right che<!-- truncated -->',
            Body__c = '\n        <div class="container-fluid">\n            <!--<div class="row justify-content-center">\n                <div class="col-lg-5">\n                    <div class="section_tittle text-center">\n                        <p>recent work</p>\n                        <h2>Creative work for client</h2>\n                    </div>\n                </div>\n            </div>-->\n            <div class="row">\n                <div class="col-lg-12">\n                    \n                    <div class="single_work">\n                        <div class="row align-items-center">\n                            <div class="container">\n\t\t\t\t\t\t\t\t<h3>New to Choice? Welcome!</h3>\n                             <p>Choice wants to help you along your opening journey.  For new hotels, Choice has developed these checklists to get you started with  key local marketing activities to fit your hotel’s opening. Simply choose the  right checklist, and get started: </p>\n                             <ul id="content">\n                               <li><a href="?Action=GET&amp;ID=brandstandards/localmarketing/files/Local_Marketing_Checklist_-_NEW_Hotels_January_2024.pdf">Local Marketing Checklist – New Build Hotels</a> (2 Pages PDF)</li>\n                               <li><a href="?Action=GET&amp;ID=brandstandards/localmarketing/files/Local_Marketing_Checklist_-_Conversion_Hotels_-_February_2024.pdf">Local Marketing Checklist – Conversion Hotels</a> (2 Pages PDF)</li>\n                               <li><a href="?Action=GET&amp;ID=brandstandards/localmarketing/files/Local_Marketing_Checklist_-_Repositioning_Hotels_February_2024.pdf">Local Marketing Checklist – Choice to Choice Repositioning Hotels</a> (2 Pages PDF)</li>\n                              </ul>\n                                <p>Openings Press Release Templates are available on SmartMarketing in the Public Relations Catalog (folder).<br>\n                                  SmartMarketing is available on your Okta homepage (choicehotels.okta.com)\nIf you do not have access, it can be requested via <a href="https://choicehotels.service-now.com/hp?id=sc_cat_item&amp;sys_id=6444611b872bb51053e0ed3e8bbb35ad" target="_blank">ChoiceNow</a>.</p>\n                             <p>Click here to find a <a href="?Action=GET&amp;ID=brandstandards/localmarketing/files/Welcome_to_the_Choice_Hotels_Family_of_Brands_-_Marketing_Overview_and_Actions_for_NEW_Hotels.pdf">Marketing Overview</a> (19 Pages PDF) for new hotels within the Choice family of brands.</p>\n                             <p>You also  have access to the <a href="https://openings.choiceuniversity.net/" target="_blank">Openings Website</a>; this site provides  additional information and resources to help open your hotel.&nbsp; To access  this resource you will need to log into&nbsp;<a href="https://www.choiceuniversity.net/" target="_blank">ChoiceU.com</a>. If you have any questions, please contact&nbsp;<a href="mailto:openingservices@choicehotels.com">Choice  Openings</a></p>\n                            </div>\n                            \n                        </div>\n                    </div>\n                    \n                    \n                    \n                   \n \n                </div>\n            </div>\n        </div>\n    ',
            Status__c = 'Published'
        ));

        translations.add(new Translations__c(
            Content__c = categoryMap.get(LIBRARY_ID_PREFIX + '-b2b-marketing').Id,
            Name = 'English',
            Version__c = 1,
            Title__c = 'B2B Marketing',
            Summary__c = '\t\t\t\t\t\t\t\t  Choice has  over 100 sellers across the U.S., Canada, and CALA, representing all brands to more  than1,600 national and globally managed accounts. Choice also has a specialized  team dedicated to fostering local demand among more than 28,00<!-- truncated -->',
            Body__c = '\n        <div class="container-fluid">\n            <!--<div class="row justify-content-center">\n                <div class="col-lg-5">\n                    <div class="section_tittle text-center">\n                        <p>recent work</p>\n                        <h2>Creative work for client</h2>\n                    </div>\n                </div>\n            </div>-->\n           \n\t\t\t<div class="row">\n                <div class="col-lg-12">\n                    \n                    <div class="single_work">\n                        <div class="row align-items-center">\n                            <div class="container">\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t<div class="col-lg-12 col-sm-12 padding_hub_1">\n\t\t\t\t\t\t\t\t  <h3>B2B Marketing Opportunities</h3>\n\t\t\t\t\t\t\t\t  <p>Choice has  over 100 sellers across the U.S., Canada, and CALA, representing all brands to more  than1,600 national and globally managed accounts. Choice also has a specialized  team dedicated to fostering local demand among more than 28,000 small- to  mid-size accounts.</p>\n\t\t\t\t\t\t\t\t  <p>While Choice  drives awareness and demand through national sales efforts, hotels play a  critical role in converting opportunities and building relationships within  their local markets. Active participation in meetings, group sales, travel  management company (TMC), and consortia programs helps maximize visibility and  capture valuable business travel and group revenue opportunities.</p>\n\t\t\t\t\t\t\t\t  <p>The  following property-level marketing opportunities can help increase visibility  among meeting planners, travel managers, travel advisors, and local business  decision-makers while driving incremental group and transient business.</p>\n\t\t\t\t\t\t\t\t  <p>&nbsp;</p>\n\t\t\t\t\t\t\t\t  <h4><strong>CVENT</strong></h4>\n\t\t\t\t\t\t\t\t  <p>CVENT is the  leading venue-sourcing platform used by more than 160,000 meeting and event  planners worldwide. Maintaining a strong presence on CVENT helps increase  visibility, generate qualified leads, and position your hotel as a preferred  venue for meetings, events, and group business.                                  \n\t\t\t\t\t\t\t\t  </p><p>CVENT offers  a variety of marketing opportunities, with pricing and availability varying by  market and demand.\n\t\t\t\t\t\t\t\t  </p><p> <strong>Marketing  Opportunities:</strong>                                  \n\t\t\t\t\t\t\t\t  </p><p>Check with  your CVENT rep for up-to-date pricing and availability.                                  \n\t\t\t\t\t\t\t\t  </p><p><u>Diamond  Listing (1-4 Diamond Listing Options)</u><br>\n\t\t\t\t\t\t\t      With CVENT Diamond Listings,  you can further enhance your venue’s advertising content to highlight key information  up front, secure heightened visibility in the CSN search results, and strengthen  your presence in AI sourcing tools such as Cvent Venue Recommendations (coming  soon). Availability is limited in each market. Check with your CVENT rep for  pricing and availability.                                  \n\t\t\t\t\t\t\t\t  </p><p> <u>Smart Ads</u><br>\n\t\t\t\t\t\t\t      Target event planners while  they are actively researching venues across the CVENT network, helping keep  your property top of mind throughout the planning journey.                                  \n\t\t\t\t\t\t\t\t  </p><p> <u>CVENT  Planner Sourcing Report</u><br>\n\t\t\t\t\t\t\t      Gain valuable insights into  planner activity, market demand trends, and sourcing behavior to better inform  your sales strategy.                                  \n\t\t\t\t\t\t\t\t  </p><p> <u>Planner  Navigator<br>\n\t\t\t\t\t\t          </u>Identify and engage  planners who are actively sourcing events in your market, allowing your team to  focus outreach efforts on high-potential opportunities. <a href="https://www.cvent.com/en/supplier-venue/planner-navigator">Learn More</a>                                  \n\t\t\t\t\t\t\t\t  </p><p>\n\t\t\t\t\t\t\t\t    <u>Claim  Wedding Spot<br>\n\t\t\t\t\t\t          </u>Increase visibility  among couples searching for wedding venues by claiming and optimizing your  Wedding Spot profile. <a href="https://www.cvent.com/en/cvent-wedding-spot">Learn More</a>                                  \n\t\t\t\t\t\t\t\t  </p><p><u>Audit  Full Listing &amp; Update photos</u><br>\n\t\t\t\t\t\t\t      Review your CVENT profile every  3–6 months to ensure photos, amenities, meeting space details, and property  descriptions accurately reflect your hotel and current offerings.</p>\n\t\t\t\t\t\t\t\t  <p>&nbsp;</p>\n\t\t\t\t\t\t\t\t  <h4><strong>Travel Management Companies (TMC) &amp;  Consortia</strong></h4>\n                                  <p><strong>Why It  Matters:</strong><br>\n                                  Travel Management Companies  (TMCs) and consortia networks influence millions of corporate and leisure  travel bookings annually. Through Choice Hotels’ preferred partnerships and  Pay-for-Performance (PFP) programs, participating hotels gain enhanced  visibility with some of the most influential travel advisors and agencies  worldwide.</p>\n                                  <p> <strong>Market  Reach:</strong><br>\n                                  Travel agents primarily use the Global Distribution Systems* (GDS) as their  channel of choice to make real-time reservations for both corporate and leisure  travelers and are doing so in record numbers. GDSs help hotels access nearly  100,000 portals and more than 600,000 travel agents worldwide.**</p>\n                                  <p> <em>*Global  Distribution Systems (GDS): Amadeus, Sabre, Travelport (Worldspan, Apollo,  Galileo)</em></p>\n                                  <p>                                    Learn more  about <a href="https://connect.choicehotels.com/resources?name=00442-Travel-Management-Companies--Consortia&amp;tabName=Reference">TMC &amp; Consortia Market</a>.</p>\n                                  <p> <strong>Hotel  Responsibility</strong><br>\n                                    To maximize opportunities generated through Choice’s TMC and Consortia  partnerships, hotels should maintain accurate GDS content, competitive rate  availability, current amenities, and timely responses to travel advisor  inquiries. Active participation helps improve visibility and conversion within  these channels.</p>\n                                  <p> <strong>Marketing Opportunities:</strong><br>\n                                    <a href="?Action=GET&amp;ID=brandstandards/localmarketing/files/TMC_Marketing_Programs.pdf">TMC Property Level Marketing  Opportunities</a> (1 Page PDF)<br>\n                                    <a href="?Action=GET&amp;ID=brandstandards/localmarketing/files/TMC_Secondary_Programs_2026_Connect.pdf">Search the National Account List</a> (3 Page PDF)</p>\n<!-- end content -->\n                                    \n                                    </div>\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t</div>\n                            </div>\n                            \n                        </div>\n                    </div>\n                    \n                    \n                    \n                   \n \n                </div>\n                           </div>\n        </div>\n    ',
            Status__c = 'Published'
        ));

        translations.add(new Translations__c(
            Content__c = categoryMap.get(LIBRARY_ID_PREFIX + '-choice-accelerate').Id,
            Name = 'English',
            Version__c = 1,
            Title__c = 'Choice Accelerate',
            Summary__c = 'Reaching  consumers through every stage of their path to purchase, throughout the entire  marketing funnel, is key within Choice Hotel’s marketing strategy. Consumers  have new methods of researching, are influenced by channels that didn’t exist  fiv<!-- truncated -->',
            Body__c = '\n        <div class="container-fluid">\n            <!--<div class="row justify-content-center">\n                <div class="col-lg-5">\n                    <div class="section_tittle text-center">\n                        <p>recent work</p>\n                        <h2>Creative work for client</h2>\n                    </div>\n                </div>\n            </div>-->\n            <div class="row">\n                <div class="col-lg-12">\n                    \n                    <div class="single_work">\n                        <div class="row align-items-center">\n                            <div class="container">\n\t\t\t\t\t\t\t\t<img src="/choicebuys/brandstandards/LocalMarketing/images/ChoiceAccelerate_logos_RGB_FullColor.png" id="regular-top" alt="logo" title="Choice Accelerate" width="300">\n                             <p>Reaching  consumers through every stage of their path to purchase, throughout the entire  marketing funnel, is key within Choice Hotel’s marketing strategy. Consumers  have new methods of researching, are influenced by channels that didn’t exist  five orten years ago and are making purchase decisions  differently than they have in the past.</p>\n                             <p>                               Choice  Accelerate is Choice Hotel’s new paid media program that will:</p>\n                             <ul id="content">\n                               <li>Enable Choice’s digital marketing strategy to be more  targeted to reach your customers in the channels and places where they spend  time. Ensure Choice Hotels shows up throughout the customer’s travel booking  journey, across multiple channels and devices.</li>\n                               <li>Help lower reliance on OTAs to drive occupancy, competing  more effectively to reach target customers. </li>\n                               <li>Help drive bookings through cost-efficient direct channels  (choicehotels.com, Choice Hotels mobile app).</li>\n                             </ul>\n                             <p>Here are  some materials to help you learn more about Choice Accelerate:</p>\n                             <ul id="content">\n                                 <li><a href="?Action=GET&amp;ID=brandstandards/localmarketing/files/Choice_Accelerate_Overview_-_June_2026.pdf">Choice Accelerate Overview</a> (1 Page PDF)</li>\n                               <li><a href="?Action=GET&amp;ID=brandstandards/localmarketing/files/Choice_Accelerate_FAQs_June_2026.pdf">Choice Accelerate FAQs</a> (8 Page PDF)</li>\n                             </ul>\n                             <p>If you  have additional questions, please send the Choice Hotels Marketing team a question  via our <a href="https://choicehotels.service-now.com/hp?id=sc_cat_item&amp;sys_id=76efaebc8783411053e0ed3e8bbb3551" target="_blank">ChoiceNow form</a>, we will get back to you within 5-10 business  days.</p>\n                             \n                            </div>\n                            \n                        </div>\n                    </div>\n                    \n                    \n                    \n                   \n \n                </div>\n            </div>\n        </div>\n    ',
            Status__c = 'Published'
        ));

        translations.add(new Translations__c(
            Content__c = articleMap.get(LIBRARY_ID_PREFIX + '-digital-marketing-revup').Id,
            Name = 'English',
            Version__c = 1,
            Title__c = 'RevUp',
            Summary__c = 'Start Boosting Your Hotel’s Online Visibility to Help Drive More Bookings Today!',
            Body__c = '\n        <div class="container-fluid">\n            <!--<div class="row justify-content-center">\n                <div class="col-lg-5">\n                    <div class="section_tittle text-center">\n                        <p>recent work</p>\n                        <h2>Creative work for client</h2>\n                    </div>\n                </div>\n            </div>-->\n            <div class="row">\n                <div class="col-lg-12">\n                    \n                    <div class="single_work">\n                        <div class="row align-items-center">\n                            <div class="container">\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t<div class="col-lg-8 col-sm-8 padding_hub_1">\n\t\t\t\t\t\t\t\t\t<div class="about_text_left">\n\t\t\t\t\t\t\t\t\t\t<h3><img src="../img/RevUp-Powered-by-Koddi-Logo.jpg" alt=""></h3>\n\t\t\t\t\t\t\t\t\t\t<p><strong>Start Boosting Your Hotel’s Online Visibility to Help Drive More Bookings Today!</strong></p>\n                             <p>As you have seen within the Local Marketing Support Suite, digital  marketing is an important area of focus within marketing. There are many different  tactics that Choice deploys and that you can leverage to help increase  visibility and drive bookings at your hotel. </p>\n                             <p> To make this even easier for you and your team, Choice is pleased  to provide <strong>RevUp</strong>. RevUp is a turnkey marketing program that makes  localized digital marketing easy.</p>\n                             <p> RevUp enables you to easily invest in marketing tactics, including: </p>\n                            \n                               <ul id="content">\n                                 <li><strong>Direct Channel:</strong> invest in metasearch, sponsored placements and paid search to help boost your hotel’s online visibility and drive more choicehotels.com bookings. </li>\n                                 <ul id="content">\n                                   <li>What is metasearch, sponsored placements and paid search? These paid placements help position your hotel (with a link to ChoiceHotels.com) above the competition and OTAs in aggregators, such as Google Hotel Ads or in a search on Google.</li>\n                                 </ul>\n                                 <li><strong>OTA:</strong> invest in Expedia Travel Ads and BNSA to help capture more visibility than your competitors.</li>\n                               </ul>\n                               <p><a href="http://revup.koddi.com/" target="_blank" class="btn_hub_1">Click here to get started today</a></p>\n                               \n                             \n                             <p>Here’s some additional information about RevUp:</p>\n                             <ul id="content">\n   <li> <a href="?Action=GET&amp;ID=brandstandards/localmarketing/files/Choice_-_Funding_Guide_Direct_Bill_only.pdf">Choice - Funding Guide Direct Bill only</a> (2 Page PDF)</li>\n   <li> <a href="?Action=GET&amp;ID=brandstandards/localmarketing/files/Choice_-_Tactic_Overview.pdf">Choice - Tactic Overview</a> (1 Page PDF)</li>\n   <li><a href="?Action=GET&amp;ID=brandstandards/localmarketing/files/Choice_RevUp_-_Live_Chat_Onesheet.pdf"> Choice RevUp - Live Chat Onesheet</a> (1 Page PDF)</li>\n   <li><a href="?Action=GET&amp;ID=brandstandards/localmarketing/files/Choice_RevUp_-_Program_Overview_FAQ.pdf"> Choice RevUp - Program Overview FAQ</a> (3 Page PDF)</li>\n   <li> <a href="?Action=GET&amp;ID=brandstandards/localmarketing/files/Choice_RevUp_Reco_Engine_-_How_it_Works.pdf">Choice RevUp Reco Engine - How it Works</a> (1 Page PDF)</li>\n   <li> <a href="?Action=GET&amp;ID=brandstandards/localmarketing/files/Choice_RevUp_Reco_Engine_-_Overview.pdf">Choice RevUp Reco Engine - Overview</a> (3 Page PDF)</li>\n   <li><a href="?Action=GET&amp;ID=brandstandards/localmarketing/files/choicerevup_bestpractices_guide.pdf"> Choice RevUp Best Practices Guide</a> (6 Page PDF)</li>\n   <li><a href="?Action=GET&amp;ID=brandstandards/localmarketing/files/RevUp_Paid_Social_Guide.pdf">RevUp Paid Social Guide</a> (2 Page PDF)</li>\n   <li><a href="?Action=GET&amp;ID=brandstandards/localmarketing/files/RevUp_Case_Study_-_Economy.pdf">RevUp Case Study - Economy</a> (1 Page PDF)</li>\n   <li><a href="?Action=GET&amp;ID=brandstandards/localmarketing/files/RevUp_Case_Study_-_Extended_Stay.pdf"> RevUp Case Study - Extended Stay</a> (1 Page PDF)</li>\n   <li><a href="?Action=GET&amp;ID=brandstandards/localmarketing/files/RevUp_Case_Study_-_Midscale.pdf">RevUp Case Study - Midscale</a> (1 Page PDF)</li>\n   <li><a href="?Action=GET&amp;ID=brandstandards/localmarketing/files/RevUp_Case_Study_-_Upscale.pdf">     RevUp Case Study - Upscale</a> (1 Page PDF)</li>\n                             </ul>\n                                    </div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-lg-4 col-sm-4">\n\t\t\t\t\t\t\t\t\t<div class="about_text_right">\n\t\t\t\t\t\t\t\t\t  \n\n\t\t\t\t\t\t\t\t\t</div>\n   \t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n                            </div>\n                            \n                        </div>\n                    </div>\n\t\t\t\t\t\n                    \n                    \n                    \n                   \n \n                </div>\n            </div>\n        </div>\n    ',
            Status__c = 'Published'
