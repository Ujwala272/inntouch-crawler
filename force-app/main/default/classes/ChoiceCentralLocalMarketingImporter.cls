        translations.add(new Translations__c(
            Content__c = articleMap.get(LIBRARY_ID_PREFIX + '-digital-marketing-tripadvisor').Id,
            Name = 'English',
            Version__c = 1,
            Title__c = 'Tripadvisor',
            Summary__c = '                                              Tripadvisor, one of the world\'s largest travel guidance platforms*, helps travelers with travel – from planning to booking to taking a trip. Travelers across the globe use the Tripadvisor site and app to <!-- truncated -->',
            Body__c = '\n        <div class="container-fluid">\n            <!--<div class="row justify-content-center">\n                <div class="col-lg-5">\n                    <div class="section_tittle text-center">\n                        <p>recent work</p>\n                        <h2>Creative work for client</h2>\n                    </div>\n                </div>\n            </div>-->\n            <div class="row">\n                <div class="col-lg-12">\n                    \n                    <div class="single_work">\n                        <div class="row align-items-center">\n                            <div class="container">\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t<div class="col-lg-12 col-sm-12 padding_hub_1">\n                                    <div class="row" id="regular-top">\n                                        <div class="col-lg-3 col-sm-3" style="background-color: #03558b;"><h3 style="color:#fff; text-align: center">Tripadvisor</h3></div>\n                                            <div class="col-lg-9 col-sm-9 p-4" style="background-color: #f5f8eb">\n                                              <p>Tripadvisor, one of the world\'s largest travel guidance platforms*, helps travelers with travel – from planning to booking to taking a trip. Travelers across the globe use the Tripadvisor site and app to discover where to stay, what to do and where to eat based on guidance from those who have been there before. With more than 1 billion reviews and opinions of nearly 8 million businesses, travelers turn to Tripadvisor to find deals on accommodations, book experiences, reserve tables at delicious restaurants, and discover great places nearby.\n                                              </p>\n                                              <p class="footnote"><em>* Source: SimilarWeb, unique users de-duplicated monthly, June 2022<br>\n** Source: Tripadvisor internal log files </em></p>\n                                          </div>\n                                        </div>\n\t\t\t\t\t\t\t\t\t<div class="about_text_left">\n\n\t\t\t\t\t\t\t\t\t\t<h3>What does Choice do?</h3>\n                                      <p>Choice is proud to work with Tripadvisor to reach customers  who are looking  to explore travel  destinations, discover a hotel, and to read customer reviews. The following are some ways that Choice works with Tripadvisor to help drive business to your hotel: </p>\n                                      <ul id="content">\n                                          <li>National advertising campaigns </li>\n                                          <li>Tripadvisor Business Advantage (TABA) </li>\n                                          <ul id="content2">\n                                            <li>Enhanced listings for individual hotels </li>\n                                          </ul>\n                                          <li>Regional advertising campaigns  (as part of the Co-op Marketing Program) </li>\n                                        <li>Meta Search and Sponsored Placements </li>\n                                          <ul id="content2">\n                                            <li>To support chiocehotels.com bookings over Online Travel Agencies  (OTAs) </li>\n                                          </ul>\n\n                                        </ul>\n                                        <h3>What can I do?</h3>\n                                      <ul id="content">\n                                          <li>Review <a href="?Action=GET&amp;ID=brandstandards/LocalMarketing/files/Business_Advantage_Enterprise_One-Pager.pdf">Tripadvisor Business Advantage  Overview</a></li>\n                                          <li>Work with Revenue Management to ensure your hotel is in parity  with Online Travel Agencies  (OTA)</li>\n                                          <li>Refer to the <a href="https://apps.choicecentral.com/ccweb/content/resources/ReputationManagement/Toolkit/Success_toolkit.html" target="_blank">Reputation Management Success Toolkit</a> for tips on responding to guest  reviews.</li>\n                                          <li>Explore <a href="https://apps.choicecentral.com/choicebuys/brandstandards/LocalMarketing/digital-marketing/index.asp?Action=GET&amp;ID=brandstandards/localmarketing/files/One_Sheet_Choice_Hotels_and_Sojern_Pay_on_the_Stay_-_April_2022.pdf">Sojern’s Pay on the Stay</a> program to run your own paid digital media campaigns.                                      </li>\n                                        </ul>\n                                        <p>&nbsp;</p>\n                                        <h3>Tripadvisor Visual Examples</h3>\n                                      <table width="100%" border="0" cellspacing="4" cellpadding="4">\n                                          <tbody>\n                                            <tr>\n                                              <th align="center"><p align="center">Business Advantage:</p></th>\n                                              <th align="center"><p align="center">National Ad Sample  Banner Ad:</p></th>\n                                            </tr>\n                                            <tr>\n                                              <td align="center"><p><img src="../images/tripadvisor-desktop-view.jpg" width="455" height="366" alt=""></p>\n                                              <p>Desktop View </p></td>\n                                              <td align="center"><img src="../images/national-ad-sample-banner-ad.jpg" width="87" height="364" alt=""></td>\n                                            </tr>\n                                          </tbody>\n                                      </table>\n                                      <p>&nbsp;</p>\n                                        <h3>Tripadvisor Business Advantage Education Webinar</h3>\n                                        <p>\n<a href="https://p.allego.com/kCl4Vr-HO5JHK4k?ct=4x4GkwVpkx4" target="_blank"><img src="../images/Screenshot_2024-07-11_165209.jpg" width="475" height="244" alt=""></a></p>\n\t\t\t\t\t\t\t\t\t\t<p>&nbsp;</p>\n\t\t\t\t\t\t\t\t\t\t<h3>Tripadvisor FAQs</h3>\n                                        <p>This section  highlights some of the key questions that may arise.</p>\n                                        <p>&nbsp;</p>\n                                        <h4>How do I make a change  to my Tripadvisor listing?</h4>\n                                      <ul id="content">\n                                          <li>To control  your Tripadvisor listing,  simply log into the Tripadvisor <a href="https://www.tripadvisor.com/Owners" target="_blank">Management</a> Center and  to change photos, update information  and more. </li>\n                                          <li>If you have a question or an issue, please submit a <a href="https://choicehotels.service-now.com/hp?id=sc_cat_item&amp;sys_id=95903fd2db67f4909eef2ebb139619c4&amp;sysparm_category=b2149035dbb09b88cee238ff9d9619ce" target="_blank">request here</a> and Choice will assist you. </li>\n                                      </ul>\n                                      <p>&nbsp;</p>\n                                        <h4>How do I report a major  renovation?</h4>\n                                        <p>If you have completely refurbished your property and want to update your listing, you can update your TripAdvisor listing by  following these steps:</p>\n                                      <p>Visit the <a href="https://www.tripadvisor.com/OwnerSupport-a_category.4-a_topic.45" target="_blank">owner support page.</a></p>\n                                      <ul id="content">\n                                          <li>Fill out the form with the required information. </li>\n                                          <li>Attach the relative documentation. Tripadvisor requires official proof that  a top-to-bottom renovation took  place. On this webpage, you’ll see the list of accepted documents in this form. </li>\n                                          <li>Click Submit. </li>\n                                          <li>Upon verifying the documentation provided, Tripadvisor will get in touch  via email within  3- 5 business days. If your property’s renovation meets the criteria,  and substantially changes the traveler’s experience,  Tripadvisor will delete the old reviews and photos that were written prior to the renovation. Please  note that this removal is irreversible and may affect  your ranking. </li>\n                                        </ul>\n                                      <p>&nbsp;</p>\n                                      <h4>How do I update  my hotel star rating?</h4>\n                                        <p>The Hotel Class star ratings are provided to us from  third parties, such as Giata, and national  ratings organizations. These are  found on the hotel\'s listing  page in the “About” section. More information <a href="https://www.tripadvisorsupport.com/en-US/hc/owner/articles/468" target="_blank">here</a><br clear="all">\n                                        </p>\n                                      <ul id="content">\n                                          <li>Log in to the <a href="https://www.tripadvisor.com/Owners" target="_blank">Management Center</a></li>\n                                            <li>Hover over the Manage  Listing tab </li>\n                                            <li>Click Amenities (Cuisines &amp; Amenities for Restaurants) </li>\n                                            <li>Select the amenities you wish to appear on your listing </li>\n                                            <li>Click Submit </li>\n                                      </ul>\n                                      <p>&nbsp;</p>\n                                          <h4>Why  am I unable to delete the Management Photos?</h4>\n                                          <p>Tripadvisor receives a direct feed of updates  from Choice. Because these photos are provided to us via a direct feed, Tripadvisor is not able to change  them. Click here to <a href="https://choicehotels.service-now.com/hp?id=sc_cat_item&amp;sys_id=2a7bb4ecdb08b0949eef2ebb139619c2" target="_blank">add  photos</a> or click here to <a href="https://choicehotels.service-now.com/hp?id=sc_cat_item&amp;sys_id=2c063ba0db60ff007d3c751c8c961987" target="_blank">delete photos.</a></p>\n                                      <p>&nbsp;</p>\n                                          <h4>How do I report  a review?</h4>\n                                          <p>To report  a review:</p>\n                                      <ul id="content">\n                                            <li>Log in to the<a href="https://www.tripadvisor.com/Owners" target="_blank"> Management Center.</a></li>\n                                            <li>Click the Reviews tab in the top navigation bar. </li>\n                                            <li>Select Report a Review. </li>\n                                            <li>Under What is the problem with the review?  select the most appropriate reason. </li>\n                                            <li>Select the title of the review in question. </li>\n                                            <li>Leave your comment and click Submit. </li>\n                                            <li>TripAdvisor’s moderation team will have a closer  look at the review and will get back to you  via email in the next 3-5 business days. </li>\n                                          </ul>\n                                          <p>Please note that TripAdvisor only removes reviews  that violate their <a href="https://www.tripadvisorsupport.com/hc/articles/200614797" target="_blank">review guidelines,</a> are suspicious, or are posted in the  wrong location.</p>\n                                      <p>&nbsp;</p>\n                                          <h4>Tripadvisor Business Advantage</h4>\n                                          <p><strong>&nbsp;</strong><strong>I used to have my own Tripadvisor Business Advantage subscription, now Choice funds these,  what do I do?</strong></p>\n                                      <ul id="content">\n                                            <li>Choice funded Business Advantage  prior to the pandemic and has brought  back this marketing tactic  again to enhance your hotel’s visibility on Tripadvisor. </li>\n                                            <li>When your subscription  ends, your hotel will rotate into  the Choice Subscription.</li>\n                                            <li>There’s NO upfront cost to you, Choice has it  covered! It’s a pay-for-performance model, meaning Choice is covering the  upfront costs and you simply <a href="https://apps.choicecentral.com/choicebuys/brandstandards/LocalMarketing/digital-marketing/index.asp?Action=GET&amp;ID=brandstandards/localmarketing/files/CHERP_FAQs_September_2023.pdf">pay  10% on consumed stays</a> that result from the Business  Advantage enhanced listing.</li>\n                                      </ul>\n                                      <p>&nbsp;</p>\n\t\t\t\t\t\t\t\t\t\t<p>&nbsp;</p>\n\t\t\t\t\t\t\t\t\t\t<h3>What is Tripadvisor</h3>\n                             <p>Tripadvisor,  one of the world\'s largest travel guidance platforms*, helps people become  better travelers, from planning to booking to taking a trip. Travelers across  the globe use the&nbsp;Tripadvisor&nbsp;site and app to discover where to stay,  what to do and where to eat based on guidance from those who have been there  before. With more than&nbsp;1 billion reviews and opinions of&nbsp;nearly  8&nbsp;million&nbsp;businesses, travelers turn to&nbsp;Tripadvisor&nbsp;to find  deals on accommodations, book experiences, reserve tables at delicious  restaurants and discover great places nearby.</p>\n                             \n                             <ul id="content">\n                               <li><a href="?Action=GET&amp;ID=brandstandards/LocalMarketing/files/Tripadvisor_-_Overview_-_July_2024.pdf">What  is Tripadvisor?</a> (5 Pages PDF)</li>\n                               <li><a href="?Action=GET&amp;ID=brandstandards/LocalMarketing/files/Business_Advantage_Enterprise_One-Pager.pdf">Tripadvisor  Business Advantage Overview </a> (2 Pages PDF)</li>\n                               <li>I  have a question on Tripadvisor or Tripadvisor Business Advantage</li>\n                               <ul id="content">\n                                 <li>Be  sure to visit the <a href="https://www.tripadvisor.com/Owners" target="_blank">Tripadvisor Management Center</a></li>\n                                 <li>Have  another question? <a href="https://choicehotels.service-now.com/hp?id=sc_cat_item&amp;sys_id=95903fd2db67f4909eef2ebb139619c4&amp;sysparm_category=b2149035dbb09b88cee238ff9d9619ce" target="_blank">Click here</a></li>\n                               </ul>\n                               \n                             </ul>\n                             <p>Here are some additional tips from Tripadvisor:</p>\n                             <ul id="content">\n                               <li><a href="https://www.tripadvisor.com/business/insights/hotels/resources/welcome-to-your-new-management-center-for-hoteliers/" target="_blank">New Management Center</a></li>\n                               <li><a href="https://www.tripadvisor.com/business/insights/hotels/resources/telling-your-accommodations-story-through-photos" target="_blank">Telling Your Accommodations\' Story Through Photos</a></li>\n                               <li> <a href="https://www.tripadvisor.com/business/insights/hotels/resources/how-hoteliers-can-use-special-offers-to-drive-more-direct-bookings" target="_blank">Special Offers</a></li>\n                               <li><a href="https://www.tripadvisor.com/business/insights/hotels/resources/storyboard-tell-your-hotels-story-your-way" target="_blank">Storyboard: Tell your hotel’s story, your way</a></li>\n                               <li><a href="https://www.tripadvisor.com/business/insights/hotels/resources/bring-your-business-to-life-with-property-videos" target="_blank">Bring Your Business to Life with Property Videos</a></li>\n                               <li><a href="https://www.tripadvisor.com/TripAdvisorInsights/w746" target="_blank">Management Center Guide</a></li>\n                               </ul>\n                             <p>Note: be sure that your hotel\'s visuals follow your brands visual identity standards.</p>\n                                        \n                                        <p class="footnote"> *&nbsp;Source:  SimilarWeb,&nbsp;unique users de-duplicated monthly,&nbsp;June 2022 <br>\n                               **  Source: Tripadvisor internal log files</p>\n                                    </div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t</div>\n                            </div>\n                            \n                        </div>\n                    </div>\n\t\t\t\t\t\n                    \n                    \n                    \n                   \n \n                </div>\n            </div>\n        </div>\n    ',
            Status__c = 'Published'
        ));

        translations.add(new Translations__c(
            Content__c = articleMap.get(LIBRARY_ID_PREFIX + '-website-vanity-sites').Id,
            Name = 'English',
            Version__c = 1,
            Title__c = 'Vanity Sites',
            Summary__c = '                              Choice allows licensees to  create vanity websites when following the guidelines provided. ',
            Body__c = '\n        <div class="container-fluid">\n            <!--<div class="row justify-content-center">\n                <div class="col-lg-5">\n                    <div class="section_tittle text-center">\n                        <p>recent work</p>\n                        <h2>Creative work for client</h2>\n                    </div>\n                </div>\n            </div>-->\n            <div class="row">\n                <div class="col-lg-12">\n                    \n                    <div class="single_work">\n                        <div class="row align-items-center">\n                            <div class="container">\n\t\t\t\t\t\t\t\t<h3>Vanity Site</h3>\n                              <p>Choice allows licensees to  create vanity websites when following the guidelines provided. </p>\n                              <h4>Frequently Asked Questions (FAQs):</h4>\n                             <p><strong>Am I required to have a vanity site?</strong><br>\n                               No, a vanity site is not  required, but it is worth considering depending on the location of the hotel,  among other factors.&nbsp; Other items to consider should include but not be limited  to: the financial investments on site development; time commitment on  maintaining the site; and whether there is information you want to share that  otherwise cannot be added on your ChoiceHotels.com property page.<br>\n  <br>\n  <strong>Do I have to use a  Choice Qualified Vendor to build the vanity site?</strong><br>\n                               Yes, all new vanity sites must  be developed by one of Choice’s Qualified Vendors.&nbsp; Any existing vanity  sites must be switched to sites developed by a qualified vendor when an existing  contract expires.&nbsp;<br>\n  <em>*Not applicable to Ascend Hotel  Collection members or international properties.</em></p>\n                             <p><strong>Who are the Choice Qualified  Vendors for developing a vanity site: </strong><br>\n                               There are two: </p>\n                             <ul id="content">\n                               <li><a href="/choicebuys/vendors/A_Z/index.asp?VendorID=MILESTONE888&amp;M=Milestone&amp;v=cb">Milestone</a></li>\n                               <li><a href="/choicebuys/vendors/A_Z/index.asp?VendorID=MILESTONE888&amp;M=Milestone&amp;v=cb">Milestone</a></li>\n                             </ul>\n                             <p><strong>How can I track the performance of my vanity site?</strong><br>\n                               Contact your vanity site  provider Account Manager for information or see the eCommerce and Reservations Dashboard  (Choice Central Property Info Manager &gt; Reports &gt; eCommerce and  Reservations Dashboard)<br>\n  <br>\n  <strong>Who should I contact  if I want to make changes?</strong> <br>\n                               A: Please contact your vanity  site provider Account Manager.</p>\n                             <p><strong>Other important items to know  about creating a Vanity Website that we suggest you review:</strong></p>\n                             <ul id="content">\n                               <li><a href="https://apps.choicecentral.com/ccweb/content/resources/ecomm/digital-marketing-vanity-requirements.pdf" target="_blank">Vanity  Website Requirements</a></li>\n                               <li><a href="https://apps.choicecentral.com/ccweb/content/resources/ecomm/digital-marketing-domain-name-policy.pdf">Domain  Name Policy</a></li>\n                               \n                                 <li><a href="https://apps.choicecentral.com/ccweb/content/resources/ecomm/domname/DomNameAppForm.html">Domain  Name Request Form</a> </li>\n\n\n                            <li><a href="https://apps.choicecentral.com/ccweb/content/resources/ecomm/digital-marketing-domain-policy-q-and-a.pdf">US Domain Name Q&amp;A </a></li>     \n\t\t\t\t\t\t\t  </ul></div>\n                            \n                        </div>\n                    </div>\n                    \n                    \n                    \n                   \n \n                </div>\n            </div>\n        </div>\n    ',
            Status__c = 'Published'
        ));

        translations.add(new Translations__c(
            Content__c = articleMap.get(LIBRARY_ID_PREFIX + '-collateral-photography-smartmarketing').Id,
            Name = 'English',
            Version__c = 1,
            Title__c = 'SmartMarketing',
            Summary__c = 'SmartMarketing is a quick and convenient way for you and your team to ensure you’re following your brand’s visual and identity standards in your local sales and marketing efforts, and on property.',
            Body__c = '\n        <div class="container-fluid">\n            <!--<div class="row justify-content-center">\n                <div class="col-lg-5">\n                    <div class="section_tittle text-center">\n                        <p>recent work</p>\n                        <h2>Creative work for client</h2>\n                    </div>\n                </div>\n            </div>-->\n            <div class="row">\n                <div class="col-lg-12">\n                    <div class="single_work">\n                        <div class="row align-items-center">\n                            <div class="container">\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t<div class="col-lg-7 col-sm-7 padding_hub_1">\n\t\t\t\t\t\t\t\t\t<div class="about_text_left">\n\t\t\t\t\t\t\t\t\t\t<img src="/choicebuys/brandstandards/LocalMarketing/img/smart_marketing_logo.jpg" id="regular-top" alt="logo" title="Smart Marketing" width="300">\n  <p>SmartMarketing is a quick and convenient way for you and your team to ensure you’re following your brand’s visual and identity standards in your local sales and marketing efforts, and on property.</p>\n\t<h4 class="rounded-pill bg-primary" style="padding-top:.65em; padding-bottom:.65em;margin-bottom:30px;" align="center">SmartMarketing is available on your Okta homepage (<a href="https://choicehotels.okta.com" target="_blank" style="color:#00558C">choicehotels.okta.com</a>)</h4>\n\t<p>In SmartMarketing, you can: </p>\n<ul id="content"><li>Customize templates including business cards, sales flyers, digital ads, billboards and more to use in your local sales and marketing efforts.\n\t</li>\n<li>Access Choice Privileges materials to showcase our loyalty program on property and in your local sales and marketing activities. \n</li><li>Order logoed merchandise for in-hotel use, handing out at tradeshows or gifting to employees.\n</li><li>Kick off a custom request project to ensure you have what you need for an upcoming event. \n</li><li><a href="?Action=GET&amp;ID=brandstandards/localmarketing/files/SmartMarketing_Overview_and_FAQ.pdf">Click here</a> (6 Page PDF) to view a SmartMarketing overview including FAQs.</li><li><a href="https://choicehotels.service-now.com/hp?id=sc_cat_item&amp;sys_id=6444611b872bb51053e0ed3e8bbb35ad" target="_blank">Click here</a> if you need to request (or remove) SmartMarketing access for a hotel team member. (link to ChoiceNow form) </li></ul>\n<p>If you are experiencing technical issues with SmartMarketing, please contact the SmartMarketing support team provided by SupplyLogic (SLWM) by dialing 1.800.891.8501 or emailing <a href="mailto:ChoiceHotels@slwmco.com">ChoiceHotels@slwmco.com</a>.</p>\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-lg-5 col-sm-5">\n\t\t\t\t\t\t\t\t\t<div class="about_text_right">\n\t\t\t\t\t\t\t\t\t\n                                      <div style="border: red 2px solid; padding: 20px 20px 10px; margin-top:60px;"><p>The SmartMarketing site has relaunched and is available for use. As we continue the refresh, you will see new templates and items added regularly, thanks for your patience as we move all 22 of our brands on to one system. </p>\n<p>A few notes: </p>\n<ul id="content"><li>For legacy Radisson hotels, you will recognize the site, as DataSource (DAT) is now called SmartMarketing! \n  </li><li>For legacy Choice hotels, this is a new platform under the same known name of SmartMarketing. \n</li><li>For US hotels, Choice Privileges materials formerly provided by Valo are now in SmartMarketing. \n</li>\n<li>Access to the refreshed SmartMarketing site is available via Okta.\n  <ul id="content">\n    <li>If you do not have access, it can be requested via <a href="https://choicehotels.service-now.com/hp?id=sc_cat_item&amp;sys_id=6444611b872bb51053e0ed3e8bbb35ad" target="_blank">ChoiceNow</a>. </li>\n    \n  </ul>\n    </li><li>Legacy Radisson if you have not updated your QR Code  Piece / Guest Service Directory since January 2024, please do so today to remove dated information (ie Radisson Rewards Americas information). <a href="?Action=GET&amp;ID=brandstandards/localmarketing/files/Updating_your_QR_Code_Piece_-_Online_GDS.pdf">Click here</a> (2 Page PDF) for instructions on how to do this.</li>\n\n</ul>\n</div>\n\t\t\t\t\t\t\t\t\t</div>\n   \t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n                            </div>\n                            \n                        </div>\n                    </div>\n\n                </div>\n               \n            </div>\n        </div>\n    ',
            Status__c = 'Published'
        ));

        insert translations;
        System.debug('Created ' + translations.size() + ' translations');
    }

    private static void createTopicAssociations(Content__c library, Map<String, Content__c> categoryMap, Map<String, Content__c> articleMap) {
        List<CMS_Topic__c> marketingTopics = [SELECT Id FROM CMS_Topic__c WHERE Name = 'Marketing' LIMIT 1];
        if (marketingTopics.isEmpty()) {
            System.debug('Topic "Marketing" not found - skipping associations');
            return;
        }

        Id topicId = marketingTopics[0].Id;
        List<Content_Topic__c> junctions = new List<Content_Topic__c>();

        junctions.add(new Content_Topic__c(Content__c = library.Id, Topic__c = topicId));
        for (Content__c cat : categoryMap.values()) {
            junctions.add(new Content_Topic__c(Content__c = cat.Id, Topic__c = topicId));
        }
        for (Content__c art : articleMap.values()) {
            junctions.add(new Content_Topic__c(Content__c = art.Id, Topic__c = topicId));
        }

        insert junctions;
        System.debug('Created ' + junctions.size() + ' topic associations');
    }

    public static void cleanup() {
        List<Content__c> toDelete = [
            SELECT Id FROM Content__c
            WHERE Content_Unique_Id__c LIKE '00018-local-marketing-support-suite%'
        ];
        if (!toDelete.isEmpty()) {
            delete toDelete;
            System.debug('Cleaned up ' + toDelete.size() + ' old records');
        }
    }
