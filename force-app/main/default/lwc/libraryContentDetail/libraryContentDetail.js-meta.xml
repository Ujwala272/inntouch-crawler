<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Library Content Detail</masterLabel>
    <description>Library detail page with Overview tab plus dynamic tabs per Topic Category derived from related topics and child reference guides.</description>
    <targets>
        <target>lightning__RecordPage</target>
        <target>lightning__AppPage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>Content__c</object>
            </objects>
        </targetConfig>
        <targetConfig targets="lightningCommunity__Default">
            <property
                name="recordId"
                label="Library Content Id"
                type="String"
                description="Salesforce Id of the parent Library Content__c. Leave blank when placed on a record page." />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
